{
  "name": "tower-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Tower (tower.im) MCP server — 把 Tower 项目管理 API 暴露给 AI 助手",
  "type": "module",
  "bin": {
    "tower-mcp": "dist/index.js",
    "tower-mcp-auth": "dist/auth-cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "auth": "node dist/auth-cli.js",
    "test": "node --test \"dist/test/*.test.js\"",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
