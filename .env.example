# Tower OAuth 应用凭证
# 获取方式：Tower 团队 -> 点左上角团队名 -> 应用中心 -> Tower API -> 创建新应用
TOWER_CLIENT_ID=your_client_id
TOWER_CLIENT_SECRET=your_client_secret

# 方式一（推荐）：只填 refresh_token，服务会自动换取并刷新 access_token
# 用 `npm run auth` 跑一次授权流程即可拿到
TOWER_REFRESH_TOKEN=

# 方式二：直接填 access_token（2 小时过期，过期后需要手动更新）
TOWER_ACCESS_TOKEN=

# 可选配置
# TOWER_BASE_URL=https://tower.im/api/v1
# TOWER_TOKEN_FILE=~/.tower-mcp/token.json
